local function round(o, r) local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = o end
local function stroke(o, col, th, tr) local s = Instance.new("UIStroke"); s.Color = col; s.Thickness = th; s.Transparency = tr or 0; s.Parent = o end

local gui = Instance.new("ScreenGui")
gui.Name = "WANG_EXPORTER"
gui.ResetOnSpawn = false
gui.DisplayOrder = 999
gui.Parent = parent

local main = Instance.new("Frame")
main.Size = UDim2.fromOffset(300, 262)
main.Position = UDim2.new(0.5, -150, 0.5, -131)
main.BackgroundColor3 = BG
main.BorderSizePixel = 0
main.Parent = gui
round(main, 14); stroke(main, PINK, 1.5, 0.1)

local header = Instance.new("Frame")
header.Size = UDim2.new(1, 0, 0, 38)
header.BackgroundColor3 = Color3.fromRGB(60, 18, 42)
header.BorderSizePixel = 0
header.Parent = main
round(header, 14)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -50, 1, 0); title.Position = UDim2.fromOffset(12, 0)
title.BackgroundTransparency = 1; title.Text = "WANG EXPORTER  ·  RBXLX / RBXMX"
title.TextColor3 = PINK2; title.Font = Enum.Font.GothamBlack; title.TextSize = 12
title.TextXAlignment = Enum.TextXAlignment.Left; title.Parent = header

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.fromOffset(24, 24); closeBtn.Position = UDim2.new(1, -32, 0, 7)
closeBtn.BackgroundColor3 = Color3.fromRGB(50, 10, 28); closeBtn.Text = "×"
closeBtn.TextColor3 = PINK2; closeBtn.Font = Enum.Font.GothamBold; closeBtn.TextSize = 16
closeBtn.Parent = header; round(closeBtn, 6)
closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)

local nameWrap = Instance.new("Frame")
nameWrap.Size = UDim2.new(1, -24, 0, 30); nameWrap.Position = UDim2.fromOffset(12, 48)
nameWrap.BackgroundColor3 = Color3.fromRGB(24, 14, 22); nameWrap.BorderSizePixel = 0; nameWrap.Parent = main
round(nameWrap, 8); stroke(nameWrap, Color3.fromRGB(140, 40, 90), 1, 0.4)

local nameBox = Instance.new("TextBox")
nameBox.Size = UDim2.new(1, -16, 1, 0); nameBox.Position = UDim2.fromOffset(8, 0)
nameBox.BackgroundTransparency = 1; nameBox.PlaceholderText = "nama file (opsional)"
nameBox.PlaceholderColor3 = Color3.fromRGB(125, 90, 108); nameBox.Text = ""
nameBox.TextColor3 = TXT; nameBox.Font = Enum.Font.GothamMedium; nameBox.TextSize = 11
nameBox.TextXAlignment = Enum.TextXAlignment.Left; nameBox.ClearTextOnFocus = false; nameBox.Parent = nameWrap

local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(1, -24, 0, 44); statusLabel.Position = UDim2.fromOffset(12, 196)
statusLabel.BackgroundTransparency = 1; statusLabel.Text = "READY"
statusLabel.TextColor3 = SUB; statusLabel.Font = Enum.Font.Code; statusLabel.TextSize = 9
statusLabel.TextWrapped = true; statusLabel.TextXAlignment = Enum.TextXAlignment.Left
statusLabel.TextYAlignment = Enum.TextYAlignment.Top; statusLabel.Parent = main

local track = Instance.new("Frame")
track.Size = UDim2.new(1, -24, 0, 5); track.Position = UDim2.fromOffset(12, 244)
track.BackgroundColor3 = Color3.fromRGB(30, 16, 26); track.BorderSizePixel = 0; track.Parent = main
round(track, 3)
local fill = Instance.new("Frame")
fill.Size = UDim2.new(0, 0, 1, 0); fill.BackgroundColor3 = PINK; fill.BorderSizePixel = 0; fill.Parent = track
round(fill, 3)

local function setStatus(t, color)
    statusLabel.Text = tostring(t)
    statusLabel.TextColor3 = color or SUB
end
local function setProg(v, msg)
    fill.Size = UDim2.new(math.clamp(v, 0, 1), 0, 1, 0)
    if msg then statusLabel.Text = msg; statusLabel.TextColor3 = SUB end
end

local busy = false
local function makeBtn(text, y, mode)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -24, 0, 32); b.Position = UDim2.fromOffset(12, y)
    b.BackgroundColor3 = PINK; b.Text = text; b.TextColor3 = TXT
    b.Font = Enum.Font.GothamBlack; b.TextSize = 11; b.AutoButtonColor = true; b.Parent = main
    round(b, 9)
    b.MouseButton1Click:Connect(function()
        if busy then return end
        busy = true
        setProg(0.01, "STARTING...")
        task.spawn(function()
            local ok, path, msg = pcall(doExport, mode, nameBox.Text, setStatus, setProg)
            busy = false
            if ok then
                setStatus(msg, OK)
                print("[WANG EXPORT] " .. tostring(msg))
            else
                setStatus("ERROR: " .. tostring(path), BAD)
                warn("[WANG EXPORT] " .. tostring(path))
            end
        end)
    end)
end
makeBtn("EXPORT PLACE  (.rbxlx)  — semua service", 88, "PLACE")
makeBtn("EXPORT WORKSPACE  (.rbxmx)", 126, "WORKSPACE")
makeBtn("EXPORT HASIL IMPORT SAJA  (.rbxmx)", 164, "IMPORTED")

-- drag
do
    local dragging, dragInput, dragStart, startPos
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    header.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local d = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

print("[WANG] Exporter loaded — hasil disimpan di folder " .. EXPORT_FOLDER)
