local DEGRADE = { UnionOperation = true, PartOperation = true, IntersectOperation = true, NegateOperation = true }

-- ============================================================
-- SUMBER SCRIPT
-- ============================================================
local function getScriptSource(scr)
    -- 1) teks editor Studio Lite (versi yang sedang diedit)
    local tb = scr:FindFirstChild("SL_CodeTextBox")
    if tb and (tb:IsA("TextBox") or tb:IsA("TextLabel")) then
        local t = tb.Text
        if type(t) == "string" and t ~= ""
            and t:sub(1, 17) ~= "-- [WANG Warning]" and t:sub(1, 9) ~= "-- [WANG]" then
            return t, "editor"
        end
    end
    -- 2) cache source dari WANG Importer (kalau dijalankan di executor yang sama)
    local raw = type(_G.Ezy_RAW_SOURCES) == "table" and _G.Ezy_RAW_SOURCES[scr]
    if type(raw) == "string" and raw ~= "" then return raw, "cache" end
    -- 3) Source langsung
    local ok, src = pcall(function() return scr.Source end)
    if ok and type(src) == "string" and src ~= "" then return src, "source" end
    -- 4) decompile (hanya ada di sebagian executor, tidak untuk server script)
    if type(decompile) == "function" and not scr:IsA("Script") then
        local ok2, d = pcall(decompile, scr)
        if ok2 and type(d) == "string" and d ~= "" then return d, "decompile" end
    end
    return "-- [WANG EXPORT] source tidak bisa dibaca", "missing"
end

-- ============================================================
-- FILTER
-- ============================================================
local function skipInst(ch, parent)
    local cn = ch.ClassName
    if cn == "Camera" or cn == "Terrain" or cn == "Player" or cn == "PlayerGui" then return true end
    if parent:IsA("LuaSourceContainer") and ch.Name:sub(1, 3) == "SL_" then return true end
    if parent == ReplicatedStorage and ch.Name == "StudioLiteFolder" then return true end
    if parent == workspace and Players:GetPlayerFromCharacter(ch) then return true end
    if ch:GetAttribute("EZY_LiveClone") then return true end
    return false
end

-- ============================================================
-- TULIS ITEM (rekursif)
-- ============================================================
local function writeItem(inst, ctx)
    local w = ctx.w
    local cls = inst.ClassName
    if DEGRADE[cls] then cls = "Part"; ctx.degraded += 1 end

    w:add(('<Item class="%s" referent="%s"><Properties>'):format(cls, refOf(inst, ctx)))

    local name = inst.Name
    if name:sub(1, 6) == "__EZY_" then name = "Mesh" end
    w:add(ser("string", "Name", name, ctx))

    local seen = { Name = true }
    for _, g in ipairs(GROUPS) do
        if inst:IsA(g[1]) then
            for _, p in ipairs(g.list) do
                local pn = p[1]
                if not seen[pn] then
                    seen[pn] = true
                    local ok, v = pcall(function() return inst[pn] end)
                    if ok and v ~= nil then
                        if pn == "Anchored" and RESTORE_ANCHORED then
                            local a = inst:GetAttribute("SL_Anchored")
                            if type(a) == "boolean" then v = a end
                        end
                        local s = ser(p[2], pn, v, ctx)
                        if s then w:add(s) end
                    end
                end
            end
        end
    end

    if inst:IsA("LuaSourceContainer") then
        ctx.scripts += 1
        if inst:IsA("Script") or inst:IsA("LocalScript") then
            local en = inst:GetAttribute("EZY_OriginalEnabled")
            if type(en) ~= "boolean" then
                local ok, v = pcall(function() return inst.Enabled end)
                if ok and type(v) == "boolean" then en = v
                else
                    local ok2, d = pcall(function() return inst.Disabled end)
                    en = not (ok2 and d == true)
                end
            end
            w:add(('<bool name="Disabled">%s</bool>'):format(tostring(not en)))
        end
        local src, how = getScriptSource(inst)
        ctx.srcStat[how] = (ctx.srcStat[how] or 0) + 1
        w:add('<ProtectedString name="Source">' .. cdata(src) .. '</ProtectedString>')
    end

    w:add("</Properties>")
    ctx.count += 1
    if ctx.count % 50 == 0 then ctx.progress(ctx.count) end
    softYield()

    for _, ch in ipairs(inst:GetChildren()) do
        if not skipInst(ch, inst) then writeItem(ch, ctx) end
    end
    w:add("</Item>")
end

local HEADER = '<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Meta name="ExplicitAutoJoints">true</Meta>'

local SERVICES = {
    "Workspace", "Lighting", "ReplicatedFirst", "ReplicatedStorage", "ServerScriptService",
    "ServerStorage", "StarterGui", "StarterPack", "StarterPlayer", "Teams", "SoundService",
}

local function getService(name)
    local ok, s = pcall(game.GetService, game, name)
    return ok and s or nil
end

-- ============================================================
-- EXPORT
-- ============================================================
local function doExport(mode, fileName, setStatus, setProg)
    if type(writefile) ~= "function" then error("writefile tidak tersedia di executor ini") end
    if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(EXPORT_FOLDER) then
        makefolder(EXPORT_FOLDER)
    end

    local ext = (mode == "PLACE") and ".rbxlx" or ".rbxmx"
    fileName = tostring(fileName or ""):gsub("[^%w%-_ ]", "_")
    if fileName == "" then fileName = "WANG_" .. mode .. "_" .. os.date("%H%M%S") end
    local path = EXPORT_FOLDER .. "/" .. fileName .. ext

    -- tentukan root
    local roots = {}
    local svcs = {}
    for _, n in ipairs(SERVICES) do
        local s = getService(n)
        if s then svcs[#svcs + 1] = s end
    end

    local total = 1
    if mode == "PLACE" then
        roots = svcs
    elseif mode == "WORKSPACE" then
        for _, ch in ipairs(workspace:GetChildren()) do
            if not skipInst(ch, workspace) then roots[#roots + 1] = ch end
        end
    elseif mode == "IMPORTED" then
        local function collect(inst)
            if inst:GetAttribute("EZY_ImportedObject") then
                roots[#roots + 1] = inst
                return
            end
            for _, ch in ipairs(inst:GetChildren()) do
                if not skipInst(ch, inst) then collect(ch) end
                softYield()
            end
        end
        for _, s in ipairs(svcs) do collect(s) end
    end
    if #roots == 0 then error("tidak ada objek untuk diexport") end

    for _, r in ipairs(roots) do total += #r:GetDescendants() + 1 end
    setStatus("EXPORTING • ~" .. total .. " OBJECT", false)

    local ctx = {
        ref = {}, nextRef = 0, count = 0, scripts = 0, degraded = 0, srcStat = {},
        w = Writer.new(path),
        progress = function(c) setProg(math.min(c / total, 0.99), ("WRITING %d / %d"):format(c, total)) end,
    }

    ctx.w:add('<?xml version="1.0" encoding="utf-8"?>')
    ctx.w:add(HEADER)
    for _, r in ipairs(roots) do writeItem(r, ctx) end
    ctx.w:add("</roblox>")
    ctx.w:close()

    local stat = {}
    for k, v in pairs(ctx.srcStat) do stat[#stat + 1] = k .. ":" .. v end
    table.sort(stat)
    setProg(1, "EXPORT COMPLETE")
    return path, ("%s • %d obj • %d script (%s) • union→part:%d • %.1f KB")
        :format(path, ctx.count, ctx.scripts, table.concat(stat, " "), ctx.degraded, ctx.w.bytes / 1024)
end

