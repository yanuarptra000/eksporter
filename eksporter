-- ============================================================
-- UTIL
-- ============================================================
local _lastYield = os.clock()
local function softYield(budget)
    if os.clock() - _lastYield > (budget or 0.008) then
        task.wait()
        _lastYield = os.clock()
    end
end

local function xmlEsc(s)
    s = tostring(s)
    s = s:gsub("[\0-\8\11\12\14-\31]", "")
    s = s:gsub("&", "&amp;")
    s = s:gsub("<", "&lt;")
    s = s:gsub(">", "&gt;")
    return s
end

local function cdata(s)
    s = tostring(s)
    s = s:gsub("[\0-\8\11\12\14-\31]", "")
    s = s:gsub("]]>", "]]]]><![CDATA[>")
    return "<![CDATA[" .. s .. "]]>"
end

local function num(n)
    if n ~= n then return "NAN" end
    if n == math.huge then return "INF" end
    if n == -math.huge then return "-INF" end
    return string.format("%.9g", n)
end

-- ============================================================
-- WRITER (append bertahap kalau appendfile tersedia, hemat RAM di HP)
-- ============================================================
local Writer = {}
Writer.__index = Writer
function Writer.new(path)
    local self = setmetatable({}, Writer)
    self.path = path
    self.parts = {}
    self.n = 0
    self.bytes = 0
    self.canAppend = type(appendfile) == "function"
    if self.canAppend then writefile(path, "") end
    return self
end
function Writer:add(s)
    self.n += 1
    self.parts[self.n] = s
    self.bytes += #s
    if self.canAppend and self.n >= 3000 then self:flush() end
end
function Writer:flush()
    if self.n == 0 then return end
    local chunk = table.concat(self.parts, "", 1, self.n)
    self.parts = {}
    self.n = 0
    if self.canAppend then appendfile(self.path, chunk)
    else self.parts[1] = chunk; self.n = 1 end
end
function Writer:close()
    if self.canAppend then
        self:flush()
    else
        writefile(self.path, table.concat(self.parts, "", 1, self.n))
    end
end

-- ============================================================
-- SERIALIZER PER TIPE
-- ============================================================
local function refOf(inst, ctx)
    local r = ctx.ref[inst]
    if not r then
        ctx.nextRef += 1
        r = "RBX" .. string.format("%X", ctx.nextRef)
        ctx.ref[inst] = r
    end
    return r
end

local function ser(tp, name, v, ctx)
    local n = xmlEsc(name)
    local tv = typeof(v)
    if tp == "string" then
        if type(v) ~= "string" then return nil end
        return ('<string name="%s">%s</string>'):format(n, xmlEsc(v))
    elseif tp == "bool" then
        if type(v) ~= "boolean" then return nil end
        return ('<bool name="%s">%s</bool>'):format(n, tostring(v))
    elseif tp == "int" then
        if type(v) ~= "number" then return nil end
        return ('<int name="%s">%d</int>'):format(n, math.floor(v))
    elseif tp == "int64" then
        if type(v) ~= "number" then return nil end
        return ('<int64 name="%s">%.0f</int64>'):format(n, math.floor(v))
    elseif tp == "float" then
        if type(v) ~= "number" then return nil end
        return ('<float name="%s">%s</float>'):format(n, num(v))
    elseif tp == "double" then
        if type(v) ~= "number" then return nil end
        return ('<double name="%s">%s</double>'):format(n, num(v))
    elseif tp == "token" then
        if tv == "EnumItem" then v = v.Value end
        if type(v) ~= "number" then return nil end
        return ('<token name="%s">%d</token>'):format(n, v)
    elseif tp == "Vector3" then
        if tv ~= "Vector3" then return nil end
        return ('<Vector3 name="%s"><X>%s</X><Y>%s</Y><Z>%s</Z></Vector3>'):format(n, num(v.X), num(v.Y), num(v.Z))
    elseif tp == "Vector2" then
        if tv ~= "Vector2" then return nil end
        return ('<Vector2 name="%s"><X>%s</X><Y>%s</Y></Vector2>'):format(n, num(v.X), num(v.Y))
    elseif tp == "CFrame" then
        if tv ~= "CFrame" then return nil end
        local c = {v:GetComponents()}
        return ('<CoordinateFrame name="%s"><X>%s</X><Y>%s</Y><Z>%s</Z><R00>%s</R00><R01>%s</R01><R02>%s</R02><R10>%s</R10><R11>%s</R11><R12>%s</R12><R20>%s</R20><R21>%s</R21><R22>%s</R22></CoordinateFrame>')
            :format(n, num(c[1]), num(c[2]), num(c[3]), num(c[4]), num(c[5]), num(c[6]), num(c[7]), num(c[8]), num(c[9]), num(c[10]), num(c[11]), num(c[12]))
    elseif tp == "Color3" then
        if tv ~= "Color3" then return nil end
        return ('<Color3 name="%s"><R>%s</R><G>%s</G><B>%s</B></Color3>'):format(n, num(v.R), num(v.G), num(v.B))
    elseif tp == "Color3u8" then
        if tv ~= "Color3" then return nil end
        local r = math.floor(v.R * 255 + 0.5)
        local g = math.floor(v.G * 255 + 0.5)
        local b = math.floor(v.B * 255 + 0.5)
        return ('<Color3uint8 name="Color3uint8">%.0f</Color3uint8>'):format(4278190080 + r * 65536 + g * 256 + b)
    elseif tp == "UDim" then
        if tv ~= "UDim" then return nil end
        return ('<UDim name="%s"><S>%s</S><O>%d</O></UDim>'):format(n, num(v.Scale), v.Offset)
    elseif tp == "UDim2" then
        if tv ~= "UDim2" then return nil end
        return ('<UDim2 name="%s"><XS>%s</XS><XO>%d</XO><YS>%s</YS><YO>%d</YO></UDim2>')
            :format(n, num(v.X.Scale), v.X.Offset, num(v.Y.Scale), v.Y.Offset)
    elseif tp == "Rect" then
        if tv ~= "Rect" then return nil end
        return ('<Rect2D name="%s"><min><X>%s</X><Y>%s</Y></min><max><X>%s</X><Y>%s</Y></max></Rect2D>')
            :format(n, num(v.Min.X), num(v.Min.Y), num(v.Max.X), num(v.Max.Y))
    elseif tp == "BrickColor" then
        if tv ~= "BrickColor" then return nil end
        return ('<int name="%s">%d</int>'):format(n, v.Number)
    elseif tp == "Content" then
        local url = v
        if tv == "Content" then
            local ok, u = pcall(function() return v.Uri end)
            url = ok and u or ""
        end
        if type(url) ~= "string" then return nil end
        if url == "" then return ('<Content name="%s"><null></null></Content>'):format(n) end
        return ('<Content name="%s"><url>%s</url></Content>'):format(n, xmlEsc(url))
    elseif tp == "NumberRange" then
        if tv ~= "NumberRange" then return nil end
        return ('<NumberRange name="%s">%s %s </NumberRange>'):format(n, num(v.Min), num(v.Max))
    elseif tp == "NumberSequence" then
        if tv ~= "NumberSequence" then return nil end
        local t = {}
        for _, k in ipairs(v.Keypoints) do t[#t + 1] = num(k.Time) .. " " .. num(k.Value) .. " " .. num(k.Envelope) .. " " end
        return ('<NumberSequence name="%s">%s</NumberSequence>'):format(n, table.concat(t))
    elseif tp == "ColorSequence" then
        if tv ~= "ColorSequence" then return nil end
        local t = {}
        for _, k in ipairs(v.Keypoints) do
            t[#t + 1] = num(k.Time) .. " " .. num(k.Value.R) .. " " .. num(k.Value.G) .. " " .. num(k.Value.B) .. " 0 "
        end
        return ('<ColorSequence name="%s">%s</ColorSequence>'):format(n, table.concat(t))
    elseif tp == "Font" then
        if tv ~= "Font" then return nil end
        return ('<Font name="%s"><Family><url>%s</url></Family><Weight>%d</Weight><Style>%s</Style></Font>')
            :format(n, xmlEsc(v.Family), v.Weight.Value, v.Style.Name)
    elseif tp == "Phys" then
        if tv ~= "PhysicalProperties" then return nil end
        return ('<PhysicalProperties name="%s"><CustomPhysics>true</CustomPhysics><Density>%s</Density><Friction>%s</Friction><Elasticity>%s</Elasticity><FrictionWeight>%s</FrictionWeight><ElasticityWeight>%s</ElasticityWeight></PhysicalProperties>')
            :format(n, num(v.Density), num(v.Friction), num(v.Elasticity), num(v.FrictionWeight), num(v.ElasticityWeight))
    elseif tp == "Ref" then
        if tv ~= "Instance" then return nil end
        return ('<Ref name="%s">%s</Ref>'):format(n, refOf(v, ctx))
    end
    return nil
end

